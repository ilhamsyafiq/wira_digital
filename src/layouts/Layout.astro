---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogType?: string;
}

const {
  title = 'Wiradigital — Social Media Creator Ranking Malaysia',
  description = "Discover Malaysia's top social media creators. Explore creator rankings, Wiradigital Scores, campaign performance and DailyMedia features.",
  path = '/',
  ogType = 'website',
} = Astro.props;

const siteName = 'Wiradigital';
const canonical = new URL(path, Astro.site ?? 'https://wiradigital.my').href;
---

<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#080c18" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ms_MY" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:btn focus:btn-primary"
      >Skip to content</a
    >
    <Navbar />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Progressive enhancement: scroll reveal + count-up. Tiny, no framework. -->
    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Count-up animation for [data-count]
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            const target = parseFloat(el.dataset.count || '0');
            const decimals = parseInt(el.dataset.decimals || '0', 10);
            const suffix = el.dataset.suffix || '';
            const prefix = el.dataset.prefix || '';
            countObserver.unobserve(el);
            if (prefersReduced) {
              el.textContent = prefix + target.toFixed(decimals) + suffix;
              continue;
            }
            const dur = 1200;
            const start = performance.now();
            const step = (now: number) => {
              const p = Math.min((now - start) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = prefix + (target * eased).toFixed(decimals) + suffix;
              if (p < 1) requestAnimationFrame(step);
              else el.textContent = prefix + target.toFixed(decimals) + suffix;
            };
            requestAnimationFrame(step);
          }
        },
        { threshold: 0.5 },
      );
      document.querySelectorAll('[data-count]').forEach((el) => countObserver.observe(el));

      // Progress-bar fill for [data-bar] (width percentage)
      const barObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const bar = e.target as HTMLElement;
            barObserver.unobserve(bar);
            if (prefersReduced) {
              bar.style.width = (bar.dataset.bar || '0') + '%';
              continue;
            }
            bar.style.transition = 'width 1.1s var(--ease-out-soft)';
            requestAnimationFrame(() => (bar.style.width = (bar.dataset.bar || '0') + '%'));
          }
        },
        { threshold: 0.3 },
      );
      document.querySelectorAll('[data-bar]').forEach((el) => barObserver.observe(el));
    </script>
  </body>
</html>
