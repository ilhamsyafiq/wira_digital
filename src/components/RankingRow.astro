---
import type { Creator, PlatformId } from '../data/types';
import { platformOrder, platformMap } from '../data/platforms';
import Avatar from './Avatar.astro';
import PlatformIcon from './PlatformIcon.astro';
import TrendIndicator from './TrendIndicator.astro';
import { withBase } from '../lib/url';

export interface Props {
  creator: Creator;
}
const { creator } = Astro.props;

// Serialize per-platform scores for client-side re-sorting/re-ranking.
const scoreData: Record<string, string> = { all: String(creator.score) };
for (const p of platformOrder) {
  if (typeof creator.platforms[p] === 'number') scoreData[p] = String(creator.platforms[p]);
}
const top = platformMap[creator.topPlatform];
---

<a
  href={withBase(`/creators/${creator.slug}`)}
  class="ranking-row group grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-3 rounded-2xl border border-line bg-surface/60 p-4 transition-colors hover:border-line-strong hover:bg-surface-2/80 md:grid-cols-[3.5rem_minmax(0,2.2fr)_1fr_1fr_auto_auto] md:rounded-none md:border-0 md:border-b md:border-line/70 md:bg-transparent md:px-4 md:py-3.5 md:hover:bg-white/[0.02]"
  data-row
  data-category={creator.category}
  data-state={creator.state}
  data-score-all={creator.score}
  data-scores={JSON.stringify(scoreData)}
  data-platforms={JSON.stringify(Object.keys(scoreData).filter((k) => k !== 'all'))}
  data-trend={creator.trend}
  data-trendvalue={creator.trendValue}
  data-name={creator.name.toLowerCase()}
  data-username={creator.username.toLowerCase()}
>
  <!-- Rank -->
  <div class="flex items-center">
    <span
      class="rank-badge grid h-9 w-9 place-items-center rounded-xl font-display text-sm font-800 tabular-nums text-fg"
      data-rank
    >
      {creator.rank}
    </span>
  </div>

  <!-- Creator -->
  <div class="flex min-w-0 items-center gap-3">
    <Avatar initials={creator.avatar} seed={creator.slug} size={40} />
    <div class="min-w-0">
      <div class="flex items-center gap-1.5">
        <span class="truncate font-600 text-fg">{creator.name}</span>
        {
          creator.verified && (
            <svg class="h-3.5 w-3.5 shrink-0 text-brand-400" viewBox="0 0 24 24" fill="currentColor" aria-label="Verified">
              <path d="M12 1.5l2.4 1.9 3-.3 1.2 2.8 2.7 1.4-.6 3 .6 3-2.7 1.4-1.2 2.8-3-.3L12 22.5l-2.4-1.9-3 .3-1.2-2.8-2.7-1.4.6-3-.6-3 2.7-1.4L6.6 3.1l3 .3L12 1.5Zm-1.1 13.2l5-5-1.3-1.3-3.7 3.7-1.8-1.8-1.3 1.3 3.1 3.1Z" />
            </svg>
          )
        }
      </div>
      <div class="truncate text-xs text-fg-muted">{creator.username}</div>
    </div>
  </div>

  <!-- Category (desktop) -->
  <div class="hidden md:block">
    <span class="chip">{creator.category}</span>
  </div>

  <!-- Location (desktop) -->
  <div class="hidden text-sm text-fg-muted md:block">{creator.state}</div>

  <!-- Score -->
  <div class="text-right md:pl-4">
    <div class="font-display text-xl font-800 tabular-nums text-fg" data-score>{creator.score}</div>
    <div class="text-[9px] font-600 uppercase tracking-[0.14em] text-fg-subtle" data-score-label>Wira</div>
  </div>

  <!-- Mobile meta (category + location) -->
  <div class="col-span-3 flex items-center gap-2 border-t border-line pt-3 text-xs md:hidden">
    <span class="chip">{creator.category}</span>
    <span class="text-fg-subtle">{creator.location}</span>
    <span class="ml-auto flex items-center gap-1.5 text-fg-muted">
      <span class="grid h-5 w-5 place-items-center rounded-md bg-white/5" style={`color:${top.color}`}>
        <PlatformIcon platform={creator.topPlatform} class="h-3 w-3" />
      </span>
      <TrendIndicator trend={creator.trend} value={creator.trendValue} />
    </span>
  </div>

  <!-- Trend (desktop) -->
  <div class="hidden justify-end md:flex">
    <TrendIndicator trend={creator.trend} value={creator.trendValue} />
  </div>
</a>
