---
import { withBase } from '../lib/url';
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a href={withBase('/')} class={`group inline-flex items-center ${className}`} aria-label="wiradigital home">
  <span class="font-sans text-[1.35rem] font-800 lowercase leading-none tracking-[-0.02em] text-fg">wira<span
      class="font-600 text-sky-accent">digital</span></span>
</a>
