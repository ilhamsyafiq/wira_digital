---
/**
 * Visualises how the FINAL Wiradigital Score is built:
 *   Social Media Score (base) + Campaign Bonus + DailyMedia Bonus = Final.
 * Campaign bonus is an ADDITIONAL ranking bonus, not part of the base score.
 */
export interface Props {
  base: number;
  campaignBonus: number;
  dailyMediaBonus: number;
  class?: string;
}
const { base, campaignBonus, dailyMediaBonus, class: className = '' } = Astro.props;
const final = Math.min(100, base + campaignBonus + dailyMediaBonus);

const parts = [
  { label: 'Social Media Score', value: base, kind: 'base' as const, hint: 'Prestasi sebenar di platform' },
  { label: 'Campaign Bonus', value: campaignBonus, kind: 'bonus' as const, hint: 'Markah tambahan dari kempen' },
  { label: 'DailyMedia Bonus', value: dailyMediaBonus, kind: 'bonus' as const, hint: 'Pendedahan rangkaian media' },
];
---

<div class={`card p-5 sm:p-6 ${className}`}>
  <div class="flex flex-col gap-3">
    {
      parts.map((p) => (
        <div
          class:list={[
            'flex items-center justify-between rounded-xl border px-4 py-3.5',
            p.kind === 'bonus'
              ? 'border-brand-500/25 bg-brand-500/5'
              : 'border-line bg-black/[0.025]',
          ]}
        >
          <div>
            <div class:list={['text-sm font-[600]', p.kind === 'bonus' ? 'text-brand-700' : 'text-fg']}>
              {p.label}
            </div>
            <div class="text-xs text-fg-subtle">{p.hint}</div>
          </div>
          <div
            class:list={[
              'font-display text-2xl font-[800] tabular-nums',
              p.kind === 'bonus' ? 'text-brand-600' : 'text-fg',
            ]}
          >
            {p.kind === 'bonus' ? `+${p.value}` : p.value}
          </div>
        </div>
      ))
    }
  </div>

  <div class="my-4 flex items-center gap-3 text-fg-subtle">
    <div class="h-px flex-1 bg-line"></div>
    <span class="text-xs font-[600] uppercase tracking-[0.14em]">=</span>
    <div class="h-px flex-1 bg-line"></div>
  </div>

  <div
    class="flex items-center justify-between rounded-xl border border-brand-400/40 bg-brand-500/10 px-4 py-4"
  >
    <div>
      <div class="text-sm font-[700] text-fg">Final Wiradigital Score</div>
      <div class="text-xs text-fg-muted">Base + Campaign + DailyMedia</div>
    </div>
    <div class="font-display text-4xl font-[800] tabular-nums text-gradient">
      <span data-count={final}>0</span>
    </div>
  </div>
</div>
