---
export interface Props {
  initials: string;
  seed: string;
  size?: number;
  class?: string;
}
const { initials, seed, size = 48, class: className = '' } = Astro.props;

// Deterministic gradient from the seed string — stable across renders.
const palettes = [
  ['#14b892', '#0b9678'],
  ['#8b5cf6', '#6d28d9'],
  ['#f472b6', '#be185d'],
  ['#38bdf8', '#0369a1'],
  ['#fbbf24', '#d97706'],
  ['#34d399', '#059669'],
  ['#a78bfa', '#7c3aed'],
  ['#fb7185', '#e11d48'],
];
let h = 0;
for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) >>> 0;
const [c1, c2] = palettes[h % palettes.length];
---

<span
  class={`inline-flex shrink-0 items-center justify-center rounded-full font-display font-700 text-white ${className}`}
  style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px;background:linear-gradient(135deg, ${c1}, ${c2});box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);`}
  aria-hidden="true"
>
  {initials}
</span>
