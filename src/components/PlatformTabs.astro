---
import { platforms } from '../data/platforms';
import PlatformIcon from './PlatformIcon.astro';

export interface Props {
  name?: string; // data attribute group name for JS wiring
  class?: string;
}
const { name = 'scope', class: className = '' } = Astro.props;
const tabs = [{ id: 'all', label: 'All' }, ...platforms.map((p) => ({ id: p.id, label: p.name }))];
---

<div
  class={`no-scrollbar flex gap-1.5 overflow-x-auto rounded-2xl border border-line bg-surface/60 p-1.5 ${className}`}
  role="tablist"
  data-tabs={name}
>
  {
    tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        data-tab={t.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        class:list={[
          'tab-btn flex shrink-0 items-center gap-1.5 rounded-xl px-3.5 py-2 text-sm font-600 transition-colors',
          i === 0 ? 'is-active bg-black/[0.07] text-fg' : 'text-fg-muted hover:text-fg',
        ]}
      >
        {t.id !== 'all' && <PlatformIcon platform={t.id as any} class="h-3.5 w-3.5" />}
        {t.label}
      </button>
    ))
  }
</div>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { scrollbar-width: none; }
  .tab-btn.is-active {
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
</style>
