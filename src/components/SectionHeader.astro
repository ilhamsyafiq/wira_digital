---
export interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, subtitle, align = 'left', class: className = '' } = Astro.props;
const alignCls = align === 'center' ? 'text-center items-center mx-auto' : 'text-left items-start';
---

<div class={`flex flex-col gap-3 ${alignCls} ${align === 'center' ? 'max-w-2xl' : 'max-w-3xl'} ${className}`} data-reveal>
  {eyebrow && <span class="eyebrow"><span class="h-px w-6 bg-brand-500/60"></span>{eyebrow}</span>}
  <h2 class="font-display text-3xl font-800 leading-[1.1] tracking-tight text-fg sm:text-4xl">
    <Fragment set:html={title} />
  </h2>
  {subtitle && <p class="text-base leading-relaxed text-fg-muted sm:text-lg">{subtitle}</p>}
</div>
