---
import { platforms } from '../data/platforms';
import PlatformIcon from './PlatformIcon.astro';

export interface FlowStep {
  label: string;
  desc?: string;
  highlight?: boolean;
}

export interface Props {
  steps: FlowStep[];
  fanOut?: boolean; // render the 5 platforms as the final fan-out
  class?: string;
}
const { steps, fanOut = false, class: className = '' } = Astro.props;
---

<div class={`mx-auto flex max-w-md flex-col items-stretch ${className}`}>
  {
    steps.map((s, i) => (
      <>
        <div
          class:list={[
            'flex items-center gap-4 rounded-2xl border px-5 py-4 transition-colors',
            s.highlight
              ? 'border-brand-400/40 bg-brand-500/10'
              : 'border-line bg-surface/70',
          ]}
          data-reveal
          style={`transition-delay:${i * 60}ms`}
        >
          <span
            class:list={[
              'grid h-9 w-9 shrink-0 place-items-center rounded-xl font-display text-sm font-800 tabular-nums',
              s.highlight ? 'bg-brand-500/15 text-brand-700' : 'bg-black/[0.045] text-fg-muted',
            ]}
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <div class:list={['font-600', s.highlight ? 'text-brand-700' : 'text-fg']}>{s.label}</div>
            {s.desc && <div class="text-xs text-fg-muted">{s.desc}</div>}
          </div>
        </div>
        {(i < steps.length - 1 || fanOut) && (
          <div class="flex justify-center py-1.5" aria-hidden="true">
            <svg class="h-5 w-5 text-fg-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M6 13l6 6 6-6" />
            </svg>
          </div>
        )}
      </>
    ))
  }

  {
    fanOut && (
      <div class="flex flex-wrap justify-center gap-2.5" data-reveal>
        {platforms.map((p) => (
          <span
            class="flex items-center gap-2 rounded-xl border border-line bg-surface/70 px-3.5 py-2.5 text-sm font-500 text-fg"
            style={`box-shadow: inset 0 0 0 1px transparent`}
          >
            <span class="grid h-6 w-6 place-items-center rounded-lg bg-black/[0.045]" style={`color:${p.color}`}>
              <PlatformIcon platform={p.id} class="h-3.5 w-3.5" />
            </span>
            {p.name}
          </span>
        ))}
      </div>
    )
  }
</div>
