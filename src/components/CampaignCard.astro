---
import type { Campaign } from '../data/types';
import { platformMap } from '../data/platforms';
import PlatformIcon from './PlatformIcon.astro';
import { withBase } from '../lib/url';

export interface Props {
  campaign: Campaign;
}
const { campaign } = Astro.props;

const covers: Record<string, string> = {
  sunset: 'linear-gradient(135deg,#2f5bff,#38a4e0)',
  rose: 'linear-gradient(135deg,#38a4e0,#1c3596)',
  ocean: 'linear-gradient(135deg,#2f5bff,#1c2f76)',
  aurora: 'linear-gradient(135deg,#5c82ff,#38a4e0)',
  lime: 'linear-gradient(135deg,#38a4e0,#2f5bff)',
  violet: 'linear-gradient(135deg,#1f47e6,#6bc0ee)',
};

const statusMap = {
  active: { label: 'Active', cls: 'text-rise', dot: 'bg-rise' },
  upcoming: { label: 'Upcoming', cls: 'text-gold', dot: 'bg-gold' },
  completed: { label: 'Completed', cls: 'text-stable', dot: 'bg-stable' },
} as const;
const st = statusMap[campaign.status];
---

<a href={withBase(`/campaigns/${campaign.slug}`)} class="card card-hover group flex flex-col overflow-hidden" data-reveal>
  <div class="relative h-28 overflow-hidden" style={`background:${covers[campaign.cover] ?? covers.aurora}`}>
    <div class="absolute inset-0 opacity-25 grid-overlay"></div>
    <div class="absolute inset-0" style="background:linear-gradient(180deg,transparent,rgba(10,11,18,0.7))"></div>
    <div class="absolute left-4 top-4 flex items-center gap-1.5 rounded-full bg-black/40 px-2.5 py-1 text-xs font-600 backdrop-blur-sm">
      <span class={`inline-block h-1.5 w-1.5 rounded-full ${st.dot} ${campaign.status === 'active' ? 'animate-pulse' : ''}`}></span>
      <span class={st.cls}>{st.label}</span>
    </div>
    <div class="absolute bottom-3 right-4 flex items-center gap-1.5">
      {
        campaign.platforms.map((p) => (
          <span class="grid h-6 w-6 place-items-center rounded-md bg-black/40 backdrop-blur-sm" style={`color:${platformMap[p].color}`}>
            <PlatformIcon platform={p} class="h-3.5 w-3.5" />
          </span>
        ))
      }
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="text-xs font-600 uppercase tracking-wider text-fg-subtle">{campaign.brand}</div>
    <h3 class="mt-1 font-display text-lg font-700 leading-tight text-fg group-hover:text-brand-700">
      {campaign.title}
    </h3>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-fg-muted">{campaign.description}</p>

    <div class="mt-4 flex items-center justify-between border-t border-line pt-4">
      <div class="flex items-center gap-2">
        <span class="chip">{campaign.category}</span>
        {campaign.participants > 0 && <span class="text-xs text-fg-subtle">{campaign.participants} creators</span>}
      </div>
      <div class="flex items-center gap-1.5 rounded-lg border border-brand-500/25 bg-brand-500/5 px-2.5 py-1">
        <span class="font-display text-sm font-800 tabular-nums text-brand-600">+{campaign.bonusPoints}</span>
        <span class="text-[10px] font-600 uppercase tracking-wider text-brand-700">Bonus</span>
      </div>
    </div>
  </div>
</a>
