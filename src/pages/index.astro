---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatsCard from '../components/StatsCard.astro';
import RankingExplorer from '../components/RankingExplorer.astro';
import CreatorCard from '../components/CreatorCard.astro';
import ScoreRing from '../components/ScoreRing.astro';
import ScoreBreakdown from '../components/ScoreBreakdown.astro';
import CampaignBonus from '../components/CampaignBonus.astro';
import CampaignCard from '../components/CampaignCard.astro';
import FeaturedCreator from '../components/FeaturedCreator.astro';
import DistributionFlow from '../components/DistributionFlow.astro';
import TrendIndicator from '../components/TrendIndicator.astro';
import Avatar from '../components/Avatar.astro';
import PlatformIcon from '../components/PlatformIcon.astro';

import { platforms } from '../data/platforms';
import { scoreModel } from '../data/categories';
import { creators, overallRanking, risingCreators, dailyMediaCreators } from '../data/creators';
import { activeCampaigns } from '../data/campaigns';
import { withBase } from '../lib/url';

const top = overallRanking()[0];
const topCreators = overallRanking().slice(0, 6);
const rising = risingCreators(5);
const featured = dailyMediaCreators(4);
const rankingPreview = overallRanking().slice(0, 8);
const homeCampaigns = activeCampaigns.slice(0, 3);

const ecosystem = [
  { label: 'Creator', desc: 'Kreator media sosial' },
  { label: 'Social Performance', desc: 'Prestasi merentas platform' },
  { label: 'Wiradigital Score', desc: 'Skor prestasi menyeluruh', highlight: true },
  { label: 'Multi-Platform Ranking', desc: 'Ranking keseluruhan & platform' },
  { label: 'Wiradigital Campaign', desc: 'Sertai kempen terpilih' },
  { label: 'Campaign Bonus Points', desc: 'Markah tambahan ranking', highlight: true },
  { label: 'DailyMedia Feature', desc: 'Ditampilkan dahulu', highlight: true },
  { label: 'Social Distribution', desc: 'Ke platform lebih luas' },
  { label: 'More Exposure', desc: 'Jangkauan & pertumbuhan' },
];

const howSteps = [
  { n: '01', title: 'Measure', desc: 'Kami analisa prestasi creator merentas platform media sosial.' },
  { n: '02', title: 'Rank', desc: 'Ranking dibina berdasarkan Wiradigital Score yang telus.' },
  { n: '03', title: 'Activate', desc: 'Creator menyertai kempen Wiradigital yang terpilih.' },
  { n: '04', title: 'Reward', desc: 'Prestasi kempen menjana markah bonus ranking.' },
  { n: '05', title: 'Distribute', desc: 'Creator/kandungan pilihan ditampilkan di DailyMedia & disebarkan lebih luas.' },
];
---

<Layout>
  <Hero creator={top} />

  <!-- 3. Quick platform overview -->
  <section class="container-wd py-6">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <StatsCard value={creators.length} suffix="+" label="Creators Ranked" hint="Merentas 5 platform" />
      <StatsCard value={5} label="Platforms" hint="IG · TikTok · Threads · FB · YT" />
      <StatsCard value={activeCampaigns.length} label="Active Campaigns" hint="Dengan bonus ranking" />
      <StatsCard value={dailyMediaCreators().length} label="On DailyMedia" hint="Creator ditampilkan" />
    </div>
  </section>

  <!-- 4 + 5. Live ranking with multi-platform tabs -->
  <section class="container-wd py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <SectionHeader
        eyebrow="Live Creator Ranking"
        title="Ranking merentas <span class='text-brand-gradient'>pelbagai platform</span>"
        subtitle="Susun creator mengikut Wiradigital Score keseluruhan atau ikut platform tertentu. Seorang creator boleh punya ranking berbeza pada setiap platform."
      />
      <a href={withBase('/ranking')} class="btn btn-ghost hidden shrink-0 sm:inline-flex">
        Ranking penuh
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <RankingExplorer creators={rankingPreview} showFilters={false} />
  </section>

  <!-- 6. Wiradigital Score -->
  <section id="score" class="container-wd py-16">
    <SectionHeader
      align="center"
      eyebrow="Wiradigital Score"
      title="Bukan sekadar kiraan <span class='text-brand-gradient'>followers</span>"
      subtitle="Wiradigital Score mengukur prestasi & kualiti sebenar creator merentas enam tunjang — bukan bilangan pengikut semata-mata."
      class="mb-10"
    />

    <div class="grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="card flex flex-col items-center gap-6 p-8 text-center" data-reveal>
        <ScoreRing score={top.baseScore + top.campaignBonus + top.dailyMediaBonus} size={180} label="Wira Score" />
        <div>
          <div class="font-600 text-fg">Contoh: {top.username}</div>
          <div class="text-sm text-fg-muted">Top {Math.round((top.rank / creators.length) * 100) || 5}% Malaysia · Example Score</div>
        </div>
        <div class="w-full">
          <ScoreBreakdown performance={top.performance} />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2" data-reveal>
        {
          scoreModel.map((m) => (
            <div class="card card-hover p-5">
              <div class="flex items-baseline justify-between">
                <h3 class="font-600 text-fg">{m.label}</h3>
                <span class="font-display text-2xl font-800 tabular-nums text-brand-300">{m.weight}%</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/5">
                <div class="h-full rounded-full bg-[linear-gradient(90deg,#0b9678,#34d3a1)]" style="width:0%" data-bar={m.weight * 3.33} />
              </div>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{m.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. Campaign Bonus System -->
  <section class="container-wd py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div data-reveal>
        <SectionHeader
          eyebrow="Campaign Bonus Points"
          title="Naik ranking melalui <span class='text-brand-gradient'>prestasi kempen</span>"
          subtitle="Creator yang menyertai dan menunjukkan prestasi baik dalam kempen Wiradigital boleh menerima markah bonus yang menyumbang kepada ranking mereka."
        />
        <div class="mt-6 flex flex-col gap-3">
          <div class="flex items-start gap-3 rounded-xl border border-line bg-white/[0.02] p-4">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-brand-500/15 text-brand-300">✓</span>
            <p class="text-sm text-fg-muted"><span class="font-600 text-fg">Bonus adalah tambahan.</span> Ia bukan sebahagian daripada skor media sosial biasa — ia markah bonus di atas skor asas.</p>
          </div>
          <div class="flex items-start gap-3 rounded-xl border border-line bg-white/[0.02] p-4">
            <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-brand-500/15 text-brand-300">✓</span>
            <p class="text-sm text-fg-muted"><span class="font-600 text-fg">Berasaskan prestasi.</span> Semakin baik penglibatan, kualiti & jangkauan kempen, semakin tinggi bonus.</p>
          </div>
        </div>
        <div class="mt-6 flex items-center gap-3 rounded-2xl border border-line bg-surface/60 p-4">
          <div class="text-center">
            <div class="text-xs text-fg-subtle">Ranking</div>
            <div class="font-display text-xl font-800 text-fg">#12</div>
          </div>
          <svg class="h-5 w-5 text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          <div class="text-center">
            <div class="text-xs text-fg-subtle">Selepas bonus</div>
            <div class="font-display text-xl font-800 text-brand-300">#7</div>
          </div>
          <p class="ml-auto max-w-[10rem] text-right text-xs text-fg-muted">Contoh pergerakan ranking hasil bonus kempen.</p>
        </div>
      </div>

      <div data-reveal>
        <CampaignBonus base={top.baseScore} campaignBonus={top.campaignBonus} dailyMediaBonus={top.dailyMediaBonus} />
      </div>
    </div>
  </section>

  <!-- 8. Top Creators -->
  <section class="container-wd py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <SectionHeader eyebrow="Top Creators" title="Creator teratas Malaysia" />
      <a href={withBase('/creators')} class="btn btn-ghost hidden shrink-0 sm:inline-flex">Semua creator</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {topCreators.map((c) => <CreatorCard creator={c} />)}
    </div>
  </section>

  <!-- 9. Creators on the Rise -->
  <section class="container-wd py-16">
    <SectionHeader
      eyebrow="Creators on the Rise"
      title="Creator yang sedang <span class='text-brand-gradient'>naik mendadak</span>"
      subtitle="Berbeza dengan ranking keseluruhan — ini creator dengan pertumbuhan terkini paling kuat."
      class="mb-8"
    />
    <div class="card divide-y divide-line overflow-hidden" data-reveal>
      {
        rising.map((c, i) => (
          <a href={withBase(`/creators/${c.slug}`)} class="flex items-center gap-4 px-5 py-4 transition-colors hover:bg-white/[0.02]">
            <span class="font-display text-lg font-800 tabular-nums text-fg-subtle">{String(i + 1).padStart(2, '0')}</span>
            <Avatar initials={c.avatar} seed={c.slug} size={40} />
            <div class="min-w-0 flex-1">
              <div class="truncate font-600 text-fg">{c.name} <span class="font-400 text-fg-muted">{c.username}</span></div>
              <div class="text-xs text-fg-subtle">{c.category} · {c.location}</div>
            </div>
            <span class="hidden items-center gap-1.5 text-sm text-fg-muted sm:flex" style={`color:${platforms.find((p)=>p.id===c.topPlatform)?.color}`}>
              <PlatformIcon platform={c.topPlatform} class="h-4 w-4" />
            </span>
            <TrendIndicator trend={c.trend} value={c.trendValue} size="md" showLabel />
          </a>
        ))
      }
    </div>
  </section>

  <!-- 10. Featured on DailyMedia -->
  <section class="container-wd py-16">
    <SectionHeader
      eyebrow="Featured on DailyMedia"
      title="Creator &amp; kandungan pilihan"
      subtitle="Creator dan kandungan pilihan yang sedang mendapat perhatian melalui rangkaian media kami."
      class="mb-8"
    />
    <div class="grid gap-4 md:grid-cols-2">
      {featured.map((c, i) => <FeaturedCreator creator={c} featured={i === 0} />)}
    </div>
    <div class="mt-6 text-center">
      <a href={withBase('/dailymedia')} class="btn btn-ghost">Terokai DailyMedia</a>
    </div>
  </section>

  <!-- 11. Campaigns -->
  <section class="container-wd py-16">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <SectionHeader
        eyebrow="Wiradigital Campaigns"
        title="Kempen yang menjana <span class='text-brand-gradient'>bonus ranking</span>"
      />
      <a href={withBase('/campaigns')} class="btn btn-ghost hidden shrink-0 sm:inline-flex">Semua kempen</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {homeCampaigns.map((c) => <CampaignCard campaign={c} />)}
    </div>
  </section>

  <!-- 12. DailyMedia Distribution Ecosystem + 25. Product ecosystem -->
  <section class="relative overflow-hidden py-20">
    <div class="pointer-events-none absolute inset-0 -z-10 grid-overlay opacity-40"></div>
    <div class="container-wd">
      <SectionHeader
        align="center"
        eyebrow="The Wiradigital Ecosystem"
        title="Satu aliran, dari <span class='text-brand-gradient'>prestasi ke pendedahan</span>"
        subtitle="Bagaimana prestasi media sosial bertukar menjadi ranking, bonus kempen, ciri DailyMedia dan akhirnya pengedaran yang lebih luas."
        class="mb-12"
      />
      <div class="grid items-start gap-10 lg:grid-cols-[1fr_0.9fr]">
        <div>
          <DistributionFlow steps={ecosystem} />
        </div>
        <div class="card p-6 sm:p-8" data-reveal>
          <h3 class="font-display text-xl font-700 text-fg">DailyMedia — saluran pengedaran pertama</h3>
          <p class="mt-3 text-sm leading-relaxed text-fg-muted">
            Setiap kandungan pilihan boleh <span class="text-fg">bermula di DailyMedia</span> sebelum disebarkan melalui rangkaian media sosial yang lebih luas.
          </p>
          <div class="mt-6">
            <DistributionFlow
              steps={[
                { label: 'Creator', desc: 'Kandungan berkualiti' },
                { label: 'Wiradigital', desc: 'Dinilai & disusun' },
                { label: 'DailyMedia', desc: 'Ditampilkan dahulu', highlight: true },
                { label: 'Social Distribution', desc: 'Disebarkan lebih luas' },
              ]}
              fanOut
            />
          </div>
          <p class="mt-6 rounded-xl border border-line bg-white/[0.02] p-4 text-xs leading-relaxed text-fg-muted">
            Nota: Tidak semua creator diedarkan secara automatik. Hanya kandungan <span class="text-fg">terpilih / featured</span> yang disebarkan lebih luas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 13. How Wiradigital Works -->
  <section class="container-wd py-16">
    <SectionHeader
      align="center"
      eyebrow="How Wiradigital Works"
      title="Lima langkah mudah"
      class="mb-10"
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        howSteps.map((s, i) => (
          <div class="card card-hover relative flex flex-col p-5" data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="font-display text-3xl font-800 text-brand-500/40">{s.n}</span>
            <h3 class="mt-3 font-display text-lg font-700 text-fg">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 14 + 15. For Creators / For Brands -->
  <section class="container-wd py-16">
    <div class="grid gap-6 lg:grid-cols-2">
      <div id="creators" class="card relative overflow-hidden p-8" data-reveal>
        <div class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-brand-500/10 blur-3xl"></div>
        <span class="eyebrow">For Creators</span>
        <h3 class="mt-3 font-display text-2xl font-800 text-fg">Build your presence. Improve your score. Get discovered.</h3>
        <ol class="mt-6 space-y-2.5">
          {
            [
              'Bina kehadiran media sosial anda',
              'Dinilai secara telus',
              'Tingkatkan Wiradigital Score',
              'Sertai kempen Wiradigital',
              'Kumpul markah bonus kempen',
              'Naik ranking',
              'Ditampilkan melalui DailyMedia',
              'Jangkau audiens lebih luas',
            ].map((t, i) => (
              <li class="flex items-center gap-3 text-sm text-fg-muted">
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-brand-500/12 font-display text-xs font-700 text-brand-300">{String(i + 1).padStart(2, '0')}</span>
                {t}
              </li>
            ))
          }
        </ol>
        <a href={withBase('/ranking')} class="btn btn-primary mt-7">Explore Ranking</a>
      </div>

      <div id="brands" class="card relative overflow-hidden p-8" data-reveal>
        <div class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-violet-accent/10 blur-3xl"></div>
        <span class="eyebrow" style="color:var(--color-violet-soft)">For Brands</span>
        <h3 class="mt-3 font-display text-2xl font-800 text-fg">Find creators worth watching.</h3>
        <p class="mt-4 text-sm leading-relaxed text-fg-muted">Temui creator berdasarkan data sebenar, bukan sekadar bilangan pengikut:</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            ['Platform','Category','Location','Engagement','Growth','Content Quality','Audience Quality','Wiradigital Score','Campaign Performance'].map((t) => (
              <span class="chip">{t}</span>
            ))
          }
        </div>
        <a href={withBase('/creators')} class="btn btn-ghost mt-7">Explore Creators</a>
      </div>
    </div>
  </section>

  <!-- 16. Final CTA -->
  <section class="container-wd py-16">
    <div class="card relative overflow-hidden p-10 text-center sm:p-16" data-reveal>
      <div class="pointer-events-none absolute inset-0 -z-10 grid-overlay opacity-40"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-40 bg-[radial-gradient(60%_100%_at_50%_0%,rgba(20,184,146,0.18),transparent)]"></div>
      <h2 class="mx-auto max-w-2xl font-display text-3xl font-800 leading-tight text-fg sm:text-4xl">
        Kenali siapa yang benar-benar <span class="text-gradient">memberi impak</span> di media sosial Malaysia
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-fg-muted">Discover. Rank. Influence. — satu platform untuk ranking creator merentas semua platform.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={withBase('/ranking')} class="btn btn-primary">Lihat Ranking</a>
        <a href={withBase('/dailymedia')} class="btn btn-ghost">Featured Creators</a>
      </div>
    </div>
  </section>
</Layout>
