---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ScoreRing from '../components/ScoreRing.astro';
import ScoreBreakdown from '../components/ScoreBreakdown.astro';
import CampaignBonus from '../components/CampaignBonus.astro';
import DistributionFlow from '../components/DistributionFlow.astro';
import { scoreModel } from '../data/categories';
import { overallRanking } from '../data/creators';
import { withBase } from '../lib/url';

const top = overallRanking()[0];

const steps = [
  { n: '01', title: 'Measure', desc: 'Kami analisa prestasi creator merentas platform media sosial — engagement, konsistensi, pertumbuhan & kualiti.' },
  { n: '02', title: 'Rank', desc: 'Ranking dibina berdasarkan Wiradigital Score yang telus, keseluruhan dan ikut platform.' },
  { n: '03', title: 'Activate', desc: 'Creator menyertai kempen Wiradigital yang terpilih mengikut kategori & platform.' },
  { n: '04', title: 'Reward', desc: 'Prestasi kempen yang baik menjana markah bonus yang menyumbang kepada ranking.' },
  { n: '05', title: 'Distribute', desc: 'Creator/kandungan pilihan ditampilkan di DailyMedia & boleh disebarkan melalui saluran sosial yang lebih luas.' },
];

const ecosystem = [
  { label: 'Creator' },
  { label: 'Social Performance' },
  { label: 'Wiradigital Score', highlight: true },
  { label: 'Multi-Platform Ranking' },
  { label: 'Campaign' },
  { label: 'Bonus Points', highlight: true },
  { label: 'Ranking Improvement' },
  { label: 'DailyMedia', highlight: true },
  { label: 'Social Distribution' },
  { label: 'More Exposure' },
];
---

<Layout
  title="How It Works — Wiradigital Creator Ranking Explained"
  description="Ketahui cara Wiradigital berfungsi: ukur prestasi, ranking merentas platform, Wiradigital Score, bonus kempen dan pengedaran DailyMedia."
  path="/how-it-works"
>
  <section class="container-wd pt-8 pb-14">
    <SectionHeader
      align="center"
      eyebrow="How Wiradigital Works"
      title="Dari prestasi media sosial ke <span class='text-brand-gradient'>pendedahan lebih luas</span>"
      subtitle="Lima langkah yang menerangkan bagaimana creator dinilai, disusun, diberi ganjaran dan ditampilkan."
      class="mb-10"
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        steps.map((s, i) => (
          <div class="card card-hover flex flex-col p-5" data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class="font-display text-3xl font-800 text-brand-500/40">{s.n}</span>
            <h3 class="mt-3 font-display text-lg font-700 text-fg">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Wiradigital Score -->
  <section id="score" class="container-wd py-16 scroll-mt-24">
    <SectionHeader
      eyebrow="Wiradigital Score"
      title="Apa itu Wiradigital Score?"
      subtitle="Skor prestasi menyeluruh (0–100) yang mengukur kualiti & impak sebenar creator merentas enam tunjang — bukan bilangan pengikut."
      class="mb-10"
    />
    <div class="grid items-center gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div class="card flex flex-col items-center gap-6 p-8 text-center" data-reveal>
        <ScoreRing score={top.score} size={180} label="Wira Score" />
        <div class="w-full">
          <ScoreBreakdown performance={top.performance} />
        </div>
        <p class="text-xs text-fg-subtle">Contoh skor — data ilustrasi sahaja.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2" data-reveal>
        {
          scoreModel.map((m) => (
            <div class="card card-hover p-5">
              <div class="flex items-baseline justify-between">
                <h3 class="font-600 text-fg">{m.label}</h3>
                <span class="font-display text-2xl font-800 tabular-nums text-brand-600">{m.weight}%</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-black/[0.045]">
                <div class="h-full rounded-full bg-[linear-gradient(90deg,#2f5bff,#38a4e0)]" style="width:0%" data-bar={m.weight * 3.33} />
              </div>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{m.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
    <p class="mx-auto mt-8 max-w-2xl rounded-xl border border-line bg-black/[0.025] p-4 text-center text-sm text-fg-muted">
      Penting: Bilangan pengikut <span class="text-fg">bukan</span> faktor ranking utama. Ranking mengambil kira prestasi &amp; kualiti, bukan sekadar jumlah pengikut.
    </p>
  </section>

  <!-- Campaign bonus -->
  <section class="container-wd py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div data-reveal>
        <SectionHeader
          eyebrow="Campaign Bonus"
          title="Markah bonus dari <span class='text-brand-gradient'>prestasi kempen</span>"
          subtitle="Campaign bonus ialah markah TAMBAHAN di atas skor media sosial — ia bukan sebahagian daripada skor asas."
        />
        <div class="mt-6">
          <DistributionFlow
            steps={[
              { label: 'Social Media Performance', desc: 'Prestasi platform' },
              { label: 'Base Score', desc: 'Skor asas creator' },
              { label: 'Join Wiradigital Campaign', desc: 'Sertai kempen' },
              { label: 'Campaign Performance', desc: 'Engagement, kualiti, reach' },
              { label: 'Bonus Points', desc: 'Markah tambahan', highlight: true },
              { label: 'Final Score', desc: 'Base + bonus', highlight: true },
              { label: 'Ranking Movement', desc: 'Naik ranking' },
            ]}
          />
        </div>
      </div>
      <div data-reveal>
        <CampaignBonus base={top.baseScore} campaignBonus={top.campaignBonus} dailyMediaBonus={top.dailyMediaBonus} />
      </div>
    </div>
  </section>

  <!-- Ecosystem -->
  <section class="relative overflow-hidden py-16">
    <div class="container-wd">
      <SectionHeader align="center" eyebrow="Product Ecosystem" title="Aliran penuh Wiradigital" class="mb-10" />
      <DistributionFlow steps={ecosystem} />
    </div>
  </section>

  <!-- For creators / brands -->
  <section class="container-wd py-16">
    <div class="grid gap-6 lg:grid-cols-2">
      <div id="creators" class="card relative overflow-hidden p-8 scroll-mt-24" data-reveal>
        <div class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-brand-500/10 blur-3xl"></div>
        <span class="eyebrow">For Creators</span>
        <h3 class="mt-3 font-display text-2xl font-800 text-fg">Build your presence. Improve your score. Get discovered.</h3>
        <ol class="mt-6 space-y-2.5">
          {
            [
              'Bina kehadiran media sosial anda',
              'Dinilai secara telus',
              'Tingkatkan Wiradigital Score',
              'Sertai kempen Wiradigital',
              'Kumpul markah bonus kempen',
              'Naik ranking',
              'Ditampilkan melalui DailyMedia',
              'Jangkau audiens lebih luas',
            ].map((t, i) => (
              <li class="flex items-center gap-3 text-sm text-fg-muted">
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-brand-500/12 font-display text-xs font-700 text-brand-600">{String(i + 1).padStart(2, '0')}</span>
                {t}
              </li>
            ))
          }
        </ol>
        <a href={withBase('/ranking')} class="btn btn-primary mt-7">Explore Ranking</a>
      </div>

      <div id="brands" class="card relative overflow-hidden p-8 scroll-mt-24" data-reveal>
        <div class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-sky-accent/10 blur-3xl"></div>
        <span class="eyebrow" style="color:var(--color-sky-soft)">For Brands</span>
        <h3 class="mt-3 font-display text-2xl font-800 text-fg">Find creators worth watching.</h3>
        <p class="mt-4 text-sm leading-relaxed text-fg-muted">Temui creator berdasarkan data sebenar:</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            ['Platform','Category','Location','Engagement','Growth','Content Quality','Audience Quality','Wiradigital Score','Campaign Performance'].map((t) => (
              <span class="chip">{t}</span>
            ))
          }
        </div>
        <a href={withBase('/creators')} class="btn btn-ghost mt-7">Explore Creators</a>
      </div>
    </div>
  </section>
</Layout>
